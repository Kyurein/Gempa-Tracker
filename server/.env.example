# Postgres connection string from Supabase or Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=4000
# Frontend URL allowed to call this API (use * while developing)
CORS_ORIGIN=http://localhost:5173
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Secret for POST /api/refresh (used by an external scheduler if your host sleeps)
REFRESH_SECRET=change-me
